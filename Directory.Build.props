<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.4.0-rc.1</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0-rc.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- P14 historical audit builds retain their original version. Product release publishing opts in.
       Stable 1.2.17 adds coordinated admission and keeps the habitual GPU >95 C / AC-Battery contract;
       historical thermal qualification keeps its original thresholds and separate regression checks. -->
  <PropertyGroup Condition="'$(VictusProductRelease)' == 'true'">
    <Version>1.2.17</Version>
    <AssemblyVersion>1.2.17.0</AssemblyVersion>
    <FileVersion>1.2.17.0</FileVersion>
    <InformationalVersion>1.2.17</InformationalVersion>
  </PropertyGroup>
</Project>
