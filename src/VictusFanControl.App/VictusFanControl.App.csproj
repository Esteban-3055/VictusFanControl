<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VictusFanControl.App</AssemblyName>
    <RootNamespace>VictusFanControl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/icons/program.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/Shared/ProductRecovery*.cs" Link="Recovery/%(Filename).cs" />
    <EmbeddedResource Include="../../assets/icons/*.ico" LogicalName="VictusFanControl.Icons.%(Filename).ico" />
    <ProjectReference Include="..\VictusFanControl\VictusFanControl.csproj" />
    <ProjectReference Include="../../tools/PlatformThermalReplay/PlatformThermalReplay.csproj" />
    <Compile Include="../../tools/OemShadowCapture/OemSources.cs" Link="Experimental/OemSources.cs" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
