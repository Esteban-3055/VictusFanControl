<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>VictusFanControl.PlatformThermalReplay</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VictusFanControl/VictusFanControl.csproj" />
    <ProjectReference Include="../OemShadow/OemShadow.csproj" />
  </ItemGroup>
  <Target Name="GenerateResearchInertia" BeforeTargets="CoreCompile">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="python &quot;../../scripts/generate-platform-research-inertia.py&quot; &quot;../../src/VictusFanControl/Control/Adaptive/AdaptiveFanInertiaPolicy.cs&quot; &quot;$(IntermediateOutputPath)ResearchFanInertiaPolicy.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ResearchFanInertiaPolicy.cs" />
    </ItemGroup>
  </Target>
</Project>
