<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VictusSetup</AssemblyName>
    <RootNamespace>VictusSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup Condition="'$(SetupPayload)' != ''">
    <EmbeddedResource Include="$(SetupPayload)" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(SetupPayload).sha256" LogicalName="payload.sha256" />
  </ItemGroup>
</Project>
