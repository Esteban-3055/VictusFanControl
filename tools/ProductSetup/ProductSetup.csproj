<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VictusSetup</AssemblyName>
    <RootNamespace>VictusSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/icons/program.ico</ApplicationIcon>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <InformationalVersion>1.1.3</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ProductRecovery*.cs" Link="Recovery/%(Filename).cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SetupPayload)' != ''">
    <EmbeddedResource Include="$(SetupPayload)" LogicalName="payload.zip" />
    <EmbeddedResource Include="$(SetupPayload).sha256" LogicalName="payload.sha256" />
  </ItemGroup>
</Project>
